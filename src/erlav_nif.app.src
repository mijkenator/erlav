{application, erlav_nif,
 [{description, "Fast Avro binary encoding/decoding for Erlang, implemented as a C++ NIF"},
  {vsn, "0.1.0"},
  {registered, []},
  {applications,
   [kernel,
    stdlib
   ]},
  {env,[]},
  {modules, []},

  {pkg_name, erlav},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/mijkenator/erlav"}]},
  %% Explicit list so local build output in c_src/ (*.o, *.d, pgo-data) and
  %% the test data never end up in the package.
  {files, ["src", "c_src/*.cpp", "c_src/*.cc", "c_src/*.hh", "c_src/Makefile",
           "c_src/include", "priv/*.avsc", "rebar.config", "rebar.lock",
           "README.md", "LICENSE"]}
 ]}.
