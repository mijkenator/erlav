{erl_opts, [debug_info]}.

%% Pinned: rebar3_hex 7.5.0 does not read HEX_API_KEY (api_key stays undefined
%% and publish crashes with a badmatch in hex_cli_auth); 7.0.2 does.
{plugins, [{rebar3_hex, "7.0.2"}]}.
{deps, []}.

%% erlavro and jiffy are only used by the tests and by the benchmark/helper
%% modules in perf/, never by the NIF API (src/erlav_nif.erl), so they live in
%% the test profile and are not dependencies of the published package. Build
%% the benchmarks with `rebar3 as test compile`.
{profiles, [
    {test, [
        {deps, [
            {erlavro, "2.9.8"},
            {jiffy, "1.1.1"}
        ]},
        {src_dirs, ["src", "perf"]}
    ]}
]}.

{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "make -C c_src"},
    {"(freebsd)", compile, "gmake -C c_src"}
]}.

{post_hooks, [
    {"(linux|darwin|solaris)", clean, "make -C c_src clean"},
    {"(freebsd)", clean, "gmake -C c_src clean"}
]}.
